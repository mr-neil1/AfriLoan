# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/afriloan?schema=afriloan"

# Authentication
JWT_SECRET="your_jwt_secret_key"
ADMIN_EMAIL="admin@afriloan.com"

# SMTP Email
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="contact@afriloan.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="AfriLoan <contact@afriloan.com>"

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Payment Gateways (GeniusPay / Elite)
GENIUSPAY_API_KEY=""
GENIUSPAY_API_SECRET=""
GENIUSPAY_WEBHOOK_SECRET=""
GENIUSPAY_ENVIRONMENT="sandbox"
GENIUSPAY_BASE_URL="https://api.geniuspay.com"
GENIUSPAY_WALLET_ID=""
ELITE_GATEWAY_URL=""
ELITE_GATEWAY_KEY=""
